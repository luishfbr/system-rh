# Copie para .env e ajuste. O .env NAO e versionado.
# Sem .env o docker-compose usa os defaults abaixo, entao o projeto sobe out-of-the-box.

# --- PostgreSQL ---
DB_NAME=sgc_db
DB_USER=sgc_user
DB_PASSWORD=sgc_pass
DB_PORT=5432

# --- pgAdmin ---
PGADMIN_EMAIL=admin@sgc.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080

# --- Backend ---
SERVER_PORT=8090

# Segredo de assinatura do JWT (HS256 exige no minimo 32 bytes).
# Em producao gere um novo com: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-production-min-32-bytes-long!!
JWT_EXPIRATION=PT8H
